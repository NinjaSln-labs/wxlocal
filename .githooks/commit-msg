#!/bin/bash
# Strip Cursor attribution trailers so GitHub does not list cursoragent as contributor.
# Shared across ninjasin-labs repos — install via install-git-hooks.ps1
MSG="$1"
tmp=$(mktemp)
grep -viE \
  '^(Co-authored-by:[[:space:]]*Cursor[[:space:]]*<cursoragent@cursor\.com>|Made-with:[[:space:]]*Cursor)[[:space:]]*$' \
  "$MSG" > "$tmp" || true
mv "$tmp" "$MSG"
if grep -qiE 'cursoragent@cursor\.com|837331619@qq\.com|sin@local' "$MSG"; then
  echo "commit-msg: forbidden Cursor / legacy / local email remains in message" >&2
  exit 1
fi
