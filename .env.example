# WeChat PC data directory (xwechat_files) — required for decrypt/export
WECHAT_DATA_ROOT=

# Knowledge-base root for exports / archives / registry
WECHAT_KB_ROOT=

# Override Chromium profile root for IndexedDB (optional)
WECHAT_RADIUM_PROFILES=

# Python for silent launchers (optional; default: .venv\Scripts\pythonw.exe)
WXLOCAL_PYTHON=

# --- mp-scroll pipeline ---
MP_SCROLL_INTERVAL=15
MP_SCROLL_OCR=0
WECHAT_FETCH_PROXY=http://127.0.0.1:6696

# --- chat watch pipeline ---
WECHAT_WATCH_CONTACT=FileTransfer
WECHAT_WATCH_INTERVAL=60
